# Copy to .env and fill in real values.

# --- Supabase Storage (cloud storage for trained .onnx/.joblib artifacts) --
# Dashboard: https://supabase.com/dashboard -> your project
#   1. Storage -> New bucket -> name it "models" (or set SUPABASE_MODELS_BUCKET
#      to whatever you name it). Keep it private.
#   2. Project Settings -> API -> "Project URL" -> SUPABASE_URL
#   3. Project Settings -> API -> "service_role" secret key -> SUPABASE_SERVICE_ROLE_KEY
#      (service_role bypasses row-level security -- server-side only, never
#      ship this key to a browser/desktop client)
#   4. Upload artifacts under <bucket>/<model_id>/artifacts/<file>, matching
#      the "artifact" path declared for that model in registry.py, e.g.:
#        models/phishing_detection/artifacts/phishing_classifier.joblib
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
SUPABASE_MODELS_BUCKET=models

# Local disk cache for artifacts downloaded from Supabase Storage.
MODEL_CACHE_DIR=/tmp/amcp-model-cache

# --- MLflow (optional, preferred source when configured) -------------------
# MLFLOW_TRACKING_URI=postgresql://... or http://your-hosted-mlflow:5000
